# --- Workspace -------------------------------------------------------------
# Root of the local workspace (bronze / silver / gold per project).
FORJA_DATA_DIR=data
# Metadata catalog. Defaults to $FORJA_DATA_DIR/forja_meta.duckdb.
# FORJA_META_DB_PATH=data/forja_meta.duckdb

# --- API -------------------------------------------------------------------
# Keep 127.0.0.1 until authentication lands (step 4).
FORJA_API_HOST=127.0.0.1
FORJA_API_PORT=8000
FORJA_MAX_UPLOAD_MB=200
FORJA_PREVIEW_MAX_ROWS=1000
# Bronze holds raw personal data: keep its preview disabled on shared instances
FORJA_ALLOW_BRONZE_PREVIEW=false

# --- Logging ---------------------------------------------------------------
FORJA_LOG_LEVEL=INFO
# json (default, for machines) or console (for humans)
FORJA_LOG_FORMAT=json

# --- Ingestion & profiling -------------------------------------------------
# rename (default): duplicated headers become name_2, name_3...; error: reject the file
FORJA_DUPLICATE_COLUMNS=rename
# Share of values that must match a type for it to be inferred
FORJA_PROFILING_TYPE_THRESHOLD=0.95
FORJA_PROFILING_SAMPLE_SIZE=50000
FORJA_PROFILING_TOP_VALUES=5

# --- Silver ----------------------------------------------------------------
# true: generated plans are approved without review (convenient in local mode)
FORJA_AUTO_APPROVE_SILVER=false
# Treatment of detected personal data in serving and exports: hash | mask | drop | none
FORJA_PII_DEFAULT_TREATMENT=hash
# Columns with at most this many distinct values get an accepted_values dbt test
FORJA_ACCEPTED_VALUES_MAX=10

# --- Relations -------------------------------------------------------------
# Minimum share of distinct values of a column found in a key to suggest a relation
FORJA_RELATION_MIN_INCLUSION=0.8
FORJA_RELATION_MIN_CONFIDENCE=0.6
FORJA_RELATION_MIN_DISTINCT=5
# Distinct values compared per column (deterministic sample on large tables)
FORJA_RELATION_SAMPLE_SIZE=10000
# true: relations detected with a confidence >= the threshold are confirmed directly
FORJA_AUTO_CONFIRM_RELATIONS=false
FORJA_RELATION_AUTO_CONFIRM_CONFIDENCE=0.9

# --- Jobs ------------------------------------------------------------------
# thread: background worker in the API process; inline: run on submission
FORJA_JOB_RUNNER=thread
# FORJA_DBT_EXECUTABLE=
FORJA_DBT_THREADS=1
FORJA_DBT_TIMEOUT_SECONDS=1800

# --- Serving & exports -----------------------------------------------------
# Per-project pseudonymization salts. Keep this directory outside the repository
# and back it up: losing it changes every published pseudonym.
# FORJA_SECRETS_DIR=~/.forja/secrets
FORJA_EXPORT_CSV_DELIMITER=;
FORJA_EXPORT_LOCK_TIMEOUT_SECONDS=10

# --- LLM -------------------------------------------------------------------
# anthropic | openai | ollama
FORJA_LLM_PROVIDER=ollama
# FORJA_LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
FORJA_LLM_OLLAMA_BASE_URL=http://localhost:11434
