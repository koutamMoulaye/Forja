# --- Workspace -------------------------------------------------------------
# Root of the local workspace (bronze / silver / gold per project).
FORJA_DATA_DIR=data
# Metadata catalog. Defaults to $FORJA_DATA_DIR/forja_meta.duckdb.
# FORJA_META_DB_PATH=data/forja_meta.duckdb

# --- API -------------------------------------------------------------------
# Tokens travel in clear over HTTP: keep 127.0.0.1, or put an HTTPS proxy in front.
FORJA_API_HOST=127.0.0.1
FORJA_API_PORT=8000
FORJA_MAX_UPLOAD_MB=200
FORJA_PREVIEW_MAX_ROWS=1000
# Bronze holds raw personal data: keep its preview disabled on shared instances
FORJA_ALLOW_BRONZE_PREVIEW=false

# --- Logging ---------------------------------------------------------------
FORJA_LOG_LEVEL=INFO
# json (default, for machines) or console (for humans)
FORJA_LOG_FORMAT=json

# --- Ingestion & profiling -------------------------------------------------
# rename (default): duplicated headers become name_2, name_3...; error: reject the file
FORJA_DUPLICATE_COLUMNS=rename
# Share of values that must match a type for it to be inferred
FORJA_PROFILING_TYPE_THRESHOLD=0.95
FORJA_PROFILING_SAMPLE_SIZE=50000
FORJA_PROFILING_TOP_VALUES=5

# --- Silver ----------------------------------------------------------------
# true: generated plans are approved without review (convenient in local mode)
FORJA_AUTO_APPROVE_SILVER=false
# Treatment of detected personal data in serving and exports: hash | mask | drop | none
FORJA_PII_DEFAULT_TREATMENT=hash
# Columns with at most this many distinct values get an accepted_values dbt test
FORJA_ACCEPTED_VALUES_MAX=10

# --- Relations -------------------------------------------------------------
# Minimum share of distinct values of a column found in a key to suggest a relation
FORJA_RELATION_MIN_INCLUSION=0.8
FORJA_RELATION_MIN_CONFIDENCE=0.6
FORJA_RELATION_MIN_DISTINCT=5
# Distinct values compared per column (deterministic sample on large tables)
FORJA_RELATION_SAMPLE_SIZE=10000
# true: relations detected with a confidence >= the threshold are confirmed directly
FORJA_AUTO_CONFIRM_RELATIONS=false
FORJA_RELATION_AUTO_CONFIRM_CONFIDENCE=0.9

# --- Jobs ------------------------------------------------------------------
# thread: background worker in the API process; inline: run on submission
FORJA_JOB_RUNNER=thread
# FORJA_DBT_EXECUTABLE=
FORJA_DBT_THREADS=1
FORJA_DBT_TIMEOUT_SECONDS=1800

# --- Serving & exports -----------------------------------------------------
# Per-project pseudonymization salts. Keep this directory outside the repository
# and back it up: losing it changes every published pseudonym.
# FORJA_SECRETS_DIR=~/.forja/secrets
FORJA_EXPORT_CSV_DELIMITER=;
FORJA_EXPORT_LOCK_TIMEOUT_SECONDS=10

# --- Authentication (see docs/security.md) ----------------------------------
# local: a single administrator; multi: users join projects by invitation
FORJA_AUTH_MODE=local
# First administrator, created at first start. Without a password, a random one is
# written once in the logs (event bootstrap_admin_created). It must be changed at
# first login either way.
FORJA_AUTH_BOOTSTRAP_EMAIL=admin@forja.local
# FORJA_AUTH_BOOTSTRAP_PASSWORD=
# JWT signing key; unset: generated once in FORJA_SECRETS_DIR/jwt.key
# FORJA_AUTH_SECRET=
FORJA_AUTH_ACCESS_TOKEN_MINUTES=15
FORJA_AUTH_REFRESH_TOKEN_DAYS=14
FORJA_AUTH_INVITATION_DAYS=7
FORJA_AUTH_PASSWORD_MIN_LENGTH=12

# --- Business agent (see docs/agent.md) -------------------------------------
# true: an engineer approves a validated data mart before it is published
FORJA_MART_REQUIRE_APPROVAL=false
# Rows of the verification preview sample
FORJA_MART_PREVIEW_ROWS=50
# ISO date used as "today" for relative periods (tests, evaluation); unset: the real date
# FORJA_AGENT_TODAY=

# --- LLM -------------------------------------------------------------------
# anthropic | openai | ollama. Unset: Forja uses its deterministic heuristics only.
# Providers only ever receive schemas, statistics and relations, never row values.
# Free local option: install Ollama, `ollama pull qwen3.5:9b`, then set
# FORJA_LLM_PROVIDER=ollama (see "Utiliser un LLM local gratuit" in the README).
# FORJA_LLM_PROVIDER=
# Defaults: claude-opus-5-5 (anthropic), qwen3.5:9b (ollama); required for openai
# FORJA_LLM_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Per call. Unset: 120 s for anthropic/openai, 1800 s for ollama (a local model on CPU
# can take minutes to write a Gold plan).
# FORJA_LLM_TIMEOUT_SECONDS=
# --- Ollama only
FORJA_LLM_OLLAMA_BASE_URL=http://localhost:11434
# Context window in tokens: Ollama silently truncates longer prompts. More context
# uses more memory.
FORJA_LLM_OLLAMA_NUM_CTX=16384
# Reasoning of thinking models (qwen3.5...): much slower on CPU, rarely needed here
FORJA_LLM_OLLAMA_THINK=false
# How long the model stays in memory after a call
FORJA_LLM_OLLAMA_KEEP_ALIVE=30m
# --- All providers
# Reuse the validated answer of an identical prompt (same context, task, model)
FORJA_LLM_CACHE=true
# Calls per generation (transient errors and invalid answers), with exponential backoff
FORJA_LLM_MAX_ATTEMPTS=3
FORJA_LLM_BACKOFF_BASE_SECONDS=1
FORJA_LLM_BACKOFF_MAX_SECONDS=30
FORJA_LLM_MAX_OUTPUT_TOKENS=16000
# Anthropic: output effort, and server-side fallback model when a request is declined
FORJA_LLM_EFFORT=high
FORJA_LLM_REFUSAL_FALLBACK=true
